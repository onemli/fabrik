  {
    "model": "awx.ansibletemplate",
    "pk": 4,
    "fields": {
      "name": "Create ACI EPG",
      "description": "Create Endpoint Groups (EPGs) with domain and contract bindings. Supports VMM domain integration and contract relationships.",
      "source_type": "builtin",
      "category": "epg",
      "tags": [
        "epg",
        "endpoint-group",
        "application",
        "aci"
      ],
      "table_schema": [
        {
          "table_name": "epgs",
          "description": "List of EPGs to create",
          "columns": [
            {
              "name": "tenant",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Parent tenant name"
            },
            {
              "name": "app_profile",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Application Profile name"
            },
            {
              "name": "epg_name",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "EPG name"
            },
            {
              "name": "description",
              "type": "text",
              "required": false,
              "description": "EPG description"
            },
            {
              "name": "bd",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Associated Bridge Domain"
            },
            {
              "name": "provided_contracts",
              "type": "text",
              "required": false,
              "description": "Comma-separated list of provided contracts"
            },
            {
              "name": "consumed_contracts",
              "type": "text",
              "required": false,
              "description": "Comma-separated list of consumed contracts"
            },
            {
              "name": "preferred_group",
              "type": "enum",
              "required": false,
              "enum_values": [
                "include",
                "exclude"
              ],
              "default": "exclude",
              "description": "Include in preferred group"
            }
          ],
          "min_rows": 1,
          "max_rows": 500,
          "example_data": [
            {
              "tenant": "Production",
              "app_profile": "ThreeTier_App",
              "epg_name": "Web_EPG",
              "description": "Web tier EPG",
              "bd": "Web_BD",
              "provided_contracts": "web_contract",
              "consumed_contracts": "app_contract",
              "preferred_group": "include"
            },
            {
              "tenant": "Production",
              "app_profile": "ThreeTier_App",
              "epg_name": "App_EPG",
              "description": "Application tier EPG",
              "bd": "App_BD",
              "provided_contracts": "app_contract",
              "consumed_contracts": "db_contract",
              "preferred_group": "include"
            }
          ]
        }
      ],
