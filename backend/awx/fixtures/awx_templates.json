[
  {
    "model": "awx.ansibletemplate",
    "pk": 1,
    "fields": {
      "name": "Create ACI Tenant",
      "description": "Create one or more tenants with descriptions. This template allows bulk creation of tenants in Cisco ACI fabric.",
      "source_type": "builtin",
      "category": "tenant",
      "tags": [
        "tenant",
        "basic",
        "onboarding",
        "aci"
      ],
      "table_schema": [
        {
          "table_name": "tenants",
          "description": "List of tenants to create",
          "columns": [
            {
              "name": "tenant_name",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Tenant name (alphanumeric, underscore, hyphen, max 64 chars)"
            },
            {
              "name": "description",
              "type": "text",
              "required": false,
              "description": "Tenant description"
            },
            {
              "name": "vrf_count",
              "type": "number",
              "required": false,
              "default": 1,
              "description": "Number of VRFs to create in this tenant"
            }
          ],
          "min_rows": 1,
          "max_rows": 50,
          "example_data": [
            {
              "tenant_name": "Production",
              "description": "Production environment tenant",
              "vrf_count": 3
            },
            {
              "tenant_name": "Development",
              "description": "Development environment tenant",
              "vrf_count": 1
            }
          ]
        }
      ],
      "variable_mappings": {
        "tenants": {
          "target_var": "aci_tenants",
          "column_mapping": {
            "tenant_name": "name",
            "description": "descr",
            "vrf_count": "vrf_count"
          }
        }
      },
      "awx_job_template_id": null,
      "awx_job_template_name": null,
      "awx_inventory_id": null,
      "awx_inventory_name": null,
      "requires_approval": true,
      "requires_apic_connection": true,
      "is_active": true,
      "is_public": true,
      "created_by": null,
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-01T00:00:00Z"
    }
