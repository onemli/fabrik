  {
    "model": "awx.ansibletemplate",
    "pk": 2,
    "fields": {
      "name": "Create ACI VRF",
      "description": "Create or update VRFs (Virtual Routing and Forwarding) in specified tenants. Supports BD enforcement and preferred group settings.",
      "source_type": "builtin",
      "category": "networking",
      "tags": [
        "vrf",
        "networking",
        "l3",
        "aci"
      ],
      "table_schema": [
        {
          "table_name": "vrfs",
          "description": "List of VRFs to create or update",
          "columns": [
            {
              "name": "tenant",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Parent tenant name"
            },
            {
              "name": "vrf_name",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "VRF name"
            },
            {
              "name": "description",
              "type": "text",
              "required": false,
              "description": "VRF description"
            },
            {
              "name": "preferred_group",
              "type": "enum",
              "required": false,
              "enum_values": [
                "enabled",
                "disabled"
              ],
              "default": "disabled",
              "description": "Enable preferred group (intra-EPG isolation bypass)"
            },
            {
              "name": "bd_enforcement",
              "type": "enum",
              "required": false,
              "enum_values": [
                "enforced",
                "unenforced"
              ],
              "default": "enforced",
              "description": "Bridge Domain enforcement policy"
            }
          ],
          "min_rows": 1,
          "max_rows": 100,
          "example_data": [
            {
              "tenant": "Production",
              "vrf_name": "Prod_VRF",
              "description": "Production VRF for application traffic",
              "preferred_group": "enabled",
              "bd_enforcement": "enforced"
            },
            {
              "tenant": "Production",
              "vrf_name": "Mgmt_VRF",
              "description": "Management VRF",
              "preferred_group": "disabled",
              "bd_enforcement": "enforced"
            }
          ]
        }
      ],
      "variable_mappings": {
        "vrfs": {
          "target_var": "aci_vrfs",
          "column_mapping": {
            "tenant": "tenant",
            "vrf_name": "vrf",
            "description": "descr",
            "preferred_group": "preferred_group",
            "bd_enforcement": "policy_control_preference"
          }
        }
      },
      "awx_job_template_id": null,
      "awx_inventory_id": null,
      "requires_approval": true,
      "requires_apic_connection": true,
      "is_active": true,
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-01T00:00:00Z",
      "created_by": null,
      "is_public": true,
      "awx_job_template_name": null,
      "awx_inventory_name": null
    }
  },
  {
    "model": "awx.ansibletemplate",
    "pk": 3,
    "fields": {
      "name": "Create ACI Bridge Domain",
      "description": "Create Bridge Domains with subnet configuration. Supports multiple subnets per BD and advanced L3 settings.",
      "source_type": "builtin",
      "category": "networking",
      "tags": [
        "bridge-domain",
        "bd",
        "networking",
        "l2",
        "aci"
      ],
      "table_schema": [
        {
          "table_name": "bridge_domains",
          "description": "List of Bridge Domains to create",
          "columns": [
            {
              "name": "tenant",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Parent tenant name"
            },
            {
              "name": "vrf",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Associated VRF name"
            },
            {
              "name": "bd_name",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Bridge Domain name"
            },
            {
              "name": "description",
              "type": "text",
              "required": false,
              "description": "BD description"
            },
            {
              "name": "subnet",
              "type": "text",
              "required": false,
              "validation": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$",
              "description": "Subnet in CIDR notation (e.g., 10.1.1.1/24)"
            },
            {
              "name": "gateway",
              "type": "text",
              "required": false,
              "validation": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$",
              "description": "Gateway IP address"
            },
            {
              "name": "arp_flooding",
              "type": "enum",
              "required": false,
              "enum_values": [
                "yes",
                "no"
              ],
              "default": "no",
              "description": "Enable ARP flooding"
            },
            {
              "name": "l2_unknown_unicast",
              "type": "enum",
              "required": false,
              "enum_values": [
                "proxy",
                "flood"
              ],
              "default": "proxy",
              "description": "L2 unknown unicast behavior"
            }
          ],
          "min_rows": 1,
          "max_rows": 200,
          "example_data": [
            {
              "tenant": "Production",
              "vrf": "Prod_VRF",
              "bd_name": "Web_BD",
              "description": "Bridge Domain for web tier",
              "subnet": "10.1.10.1/24",
              "gateway": "10.1.10.1",
              "arp_flooding": "no",
              "l2_unknown_unicast": "proxy"
            },
            {
              "tenant": "Production",
              "vrf": "Prod_VRF",
              "bd_name": "App_BD",
              "description": "Bridge Domain for application tier",
              "subnet": "10.1.20.1/24",
              "gateway": "10.1.20.1",
              "arp_flooding": "no",
              "l2_unknown_unicast": "proxy"
            }
          ]
        }
      ],
      "variable_mappings": {
        "bridge_domains": {
          "target_var": "aci_bridge_domains",
          "column_mapping": {
            "tenant": "tenant",
            "vrf": "vrf",
            "bd_name": "bd",
            "description": "descr",
            "subnet": "subnet",
            "gateway": "gateway",
            "arp_flooding": "arp_flood",
            "l2_unknown_unicast": "l2_unknown_unicast"
          }
        }
      },
      "awx_job_template_id": null,
      "awx_inventory_id": null,
      "requires_approval": true,
      "requires_apic_connection": true,
      "is_active": true,
      "created_at": "2024-01-01T00:00:00Z",
      "updated_at": "2024-01-01T00:00:00Z",
      "created_by": null,
      "is_public": true,
      "awx_job_template_name": null,
      "awx_inventory_name": null
    }
