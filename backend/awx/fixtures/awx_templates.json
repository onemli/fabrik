  {
    "model": "awx.ansibletemplate",
    "pk": 5,
    "fields": {
      "name": "Create ACI Contract",
      "description": "Create contracts with subjects and filters for inter-EPG communication. Supports bidirectional and unidirectional communication policies.",
      "source_type": "builtin",
      "category": "policy",
      "tags": [
        "contract",
        "policy",
        "security",
        "aci"
      ],
      "table_schema": [
        {
          "table_name": "contracts",
          "description": "List of contracts to create",
          "columns": [
            {
              "name": "tenant",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Parent tenant name"
            },
            {
              "name": "contract_name",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Contract name"
            },
            {
              "name": "description",
              "type": "text",
              "required": false,
              "description": "Contract description"
            },
            {
              "name": "scope",
              "type": "enum",
              "required": false,
              "enum_values": [
                "context",
                "global",
                "tenant",
                "application-profile"
              ],
              "default": "context",
              "description": "Contract scope"
            },
            {
              "name": "subject_name",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Contract subject name"
            },
            {
              "name": "filter_name",
              "type": "text",
              "required": true,
              "validation": "^[a-zA-Z0-9_-]{1,64}$",
              "description": "Filter name (or comma-separated list)"
            },
            {
              "name": "directives",
              "type": "enum",
              "required": false,
              "enum_values": [
                "none",
                "log"
              ],
              "default": "none",
              "description": "Contract directives"
            }
          ],
          "min_rows": 1,
          "max_rows": 100,
          "example_data": [
            {
              "tenant": "Production",
              "contract_name": "web_contract",
              "description": "Contract for web traffic",
              "scope": "context",
              "subject_name": "http_subject",
              "filter_name": "http,https",
              "directives": "log"
            },
            {
              "tenant": "Production",
              "contract_name": "app_contract",
              "description": "Contract for application tier",
              "scope": "context",
              "subject_name": "app_subject",
              "filter_name": "tcp_8080",
              "directives": "none"
            }
          ]
        }
      ],
