# =============================================================================
# Fabrik — Production Environment Configuration
# =============================================================================
# Copy to .env and fill in your values before deploying.
# For development setup, use .env.template instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Security (REQUIRED — generate unique values before first deploy)
# -----------------------------------------------------------------------------
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Rotating this key requires re-encrypting all stored APIC credentials.
ENCRYPTION_KEY=your-fernet-key-here

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DEBUG=false
ALLOWED_HOSTS=fabrik.example.com
CORS_ALLOWED_ORIGINS=https://fabrik.example.com
SITE_URL=https://fabrik.example.com
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000

# Public registration: when false (default), /api/users/register/ returns 403
# and admins create all accounts via the user management UI. Set true only for
# lab/demo deployments where self-signup is intentional.
FABRIK_ALLOW_PUBLIC_REGISTRATION=false

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
TZ=UTC
DEFAULT_USER_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# IMPORTANT: If you change POSTGRES_PASSWORD, you MUST also update the password
# inside DATABASE_URL below — Django reads DATABASE_URL, not the individual
# POSTGRES_* fields. Mismatch = "password authentication failed" on first boot.
POSTGRES_DB=fabrik
POSTGRES_USER=fabrik
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fabrik:change-me@postgres:5432/fabrik

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Redis & Celery
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -----------------------------------------------------------------------------
# RabbitMQ (AWX webhook events)
# -----------------------------------------------------------------------------
# IMPORTANT: If you change RABBITMQ_PASSWORD, you MUST also update the password
# inside RABBITMQ_URL below — the AWX event consumer reads RABBITMQ_URL, not
# the individual RABBITMQ_* fields. Mismatch = AWX events won't be processed.
RABBITMQ_USER=fabrik
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=fabrik
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://fabrik:change-me@rabbitmq:5672/fabrik

# -----------------------------------------------------------------------------
# Public-facing port (optional — defaults to 80)
# -----------------------------------------------------------------------------
# The frontend container exposes nginx on port 80. Override here if port 80 is
# already taken on the host (e.g. another web server is running). Behind a
# reverse proxy / load balancer this is rarely needed.
# FRONTEND_PORT=80

# -----------------------------------------------------------------------------
# Corporate proxy (optional — leave empty if you have direct internet access)
# -----------------------------------------------------------------------------
# Set these only if your host sits behind an HTTP/HTTPS proxy. Values are read
# at BUILD time (apt, pip, npm) and at RUNTIME (backend → APIC, MIM downloads).
# NO_PROXY must include the inter-container hostnames so service-to-service
# traffic doesn't get sent through the proxy.
#
# Note: this does NOT configure the Docker daemon itself. If `docker pull`
# fails for the base images, you also need a daemon-level proxy in
# /etc/systemd/system/docker.service.d/http-proxy.conf — see the
# "Behind a corporate proxy" page in the docs.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis,neo4j,rabbitmq,backend,frontend

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fabrik.example.com
EMAIL_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true

# -----------------------------------------------------------------------------
# LDAP (optional — enterprise SSO)
# -----------------------------------------------------------------------------
LDAP_ENABLED=false
# LDAP_SERVER_URI=ldap://ldap.company.com
# LDAP_BIND_DN=cn=admin,dc=company,dc=com
# LDAP_BIND_PASSWORD=change-me
# LDAP_USER_DN=ou=users,dc=company,dc=com
# LDAP_GROUP_DN=ou=groups,dc=company,dc=com

# -----------------------------------------------------------------------------
# Platform
# -----------------------------------------------------------------------------
FABRIK_VERSION=1.0.2
FABRIK_BASE_URL=https://fabrik.example.com

# -----------------------------------------------------------------------------
# AWX Integration
# -----------------------------------------------------------------------------
AWX_WEBHOOK_SECRET=change-me
AWX_DEFAULT_EXECUTION_MODE=bulk
AWX_JOB_SYNC_INTERVAL=10
AWX_USER_MAPPING=false
# Concurrency caps (return 429 when exceeded)
AWX_MAX_CONCURRENT_PER_USER=5
AWX_MAX_CONCURRENT_GLOBAL=20

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATELIMIT_ENABLE=true
