# ============================================
# FABRIK - Environment Configuration Template
# ============================================
#
# IMPORTANT: This is a template file!
# 1. Copy this file to .env: cp .env.template .env
# 2. Fill in your actual values in .env
# 3. Run interactive setup: ./scripts/setup.sh
#
# OR manually edit .env file
# ============================================

# ============================================
# TIMEZONE CONFIGURATION
# ============================================
# Server timezone - affects when scheduled Celery tasks run
# IMPORTANT: Set this to match your server's timezone
# Common values:
#   UTC                 - Universal Time (recommended for production)
#   Europe/Istanbul     - Turkey Time (UTC+3)
#   Europe/London       - UK Time (UTC+0/+1)
#   Europe/Paris        - Central European Time (UTC+1/+2)
#   America/New_York    - Eastern Time (UTC-5/-4)
#   America/Chicago     - Central Time (UTC-6/-5)
#   America/Los_Angeles - Pacific Time (UTC-8/-7)
#   Asia/Tokyo          - Japan Time (UTC+9)
#   Asia/Dubai          - Gulf Time (UTC+4)
#
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# Default timezone for new users (can be changed per user in settings)
# Users will see all times in their selected timezone
DEFAULT_USER_TIMEZONE=Europe/Istanbul

# ============================================
# SECURITY - CRITICAL!
# ============================================
# Django secret key - used for cryptographic signing
# MUST be unique and kept secret in production!
# Generate with: python scripts/generate-keys.py
# Or: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY_MIN_50_CHARS

# Encryption key for APIC passwords (Fernet key, base64 encoded)
# Generate with: python scripts/generate-keys.py
# Or: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_TO_RANDOM_ENCRYPTION_KEY_BASE64

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL database settings
POSTGRES_DB=fabrik
POSTGRES_USER=fabrik
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL (constructed from above values)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# NEO4J CONFIGURATION
# ============================================
# Neo4j graph database settings
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# ============================================
# REDIS CONFIGURATION
# ============================================
# Redis for Celery broker and caching
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# Celery broker and result backend
CELERY_BROKER_URL=${REDIS_URL}/0
CELERY_RESULT_BACKEND=${REDIS_URL}/1

# ============================================
# APPLICATION SETTINGS
# ============================================
# Debug mode - MUST be False in production!
DEBUG=True

# Allowed hosts - comma separated list
# In production, set to your domain names
ALLOWED_HOSTS=*

# CORS allowed origins - comma separated list
# In production, set to your frontend domains
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Site URL (for email links, etc.)
SITE_URL=http://localhost:5173

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# Email backend - for scheduled task notifications
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  # Use this for production

# SMTP settings (if using SMTP backend)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@fabrik.local

# ============================================
# PORT CONFIGURATION (Optional)
# ============================================
# Uncomment to override default ports
# Useful if you have port conflicts

# Backend API port (default: 8000)
# BACKEND_PORT=8000

# Frontend port (default: 5173)
# FRONTEND_PORT=5173

# PostgreSQL external port (default: 5432)
# POSTGRES_EXTERNAL_PORT=5432

# Redis external port (default: 6379)
# REDIS_EXTERNAL_PORT=6379

# Neo4j HTTP port (default: 7474)
# NEO4J_HTTP_PORT=7474

# Neo4j Bolt port (default: 7687)
# NEO4J_BOLT_PORT=7687

# ============================================
# ADVANCED SETTINGS (Optional)
# ============================================

# Celery worker concurrency (default: 4)
# CELERY_WORKER_CONCURRENCY=4

# Celery beat schedule interval (default: 60 seconds)
# CELERY_BEAT_INTERVAL=60

# Neo4j memory settings
# NEO4J_PAGECACHE_SIZE=512M
# NEO4J_HEAP_MAX_SIZE=1G

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# These are useful for development/debugging

# Django log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Enable SQL query logging (True/False)
# SQL_DEBUG=False

# ============================================
# END OF CONFIGURATION
# ============================================
#
# After configuring, validate with:
#   ./scripts/validate-env.sh
#
# Then start services:
#   docker compose up -d
#
